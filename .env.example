# Copy this file to `.env` and fill in your real keys.
# Each model entry in config.yaml references one of these by name via `api_key_env`.
# The .env file is gitignored and must never be committed.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...
# Local / self-hosted OpenAI-compatible servers often accept any non-empty token:
LOCAL_KEY=not-needed
